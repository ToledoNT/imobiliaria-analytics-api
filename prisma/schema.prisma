generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model imovel {
  codigo         Int         @id
  descricao      String      @db.VarChar(255)
  tipo_imovel_id Int
  tipo_imovel    tipo_imovel @relation(fields: [tipo_imovel_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_imovel_tipo")
  pagamento      pagamento[]
}

model pagamento {
  id_venda           Int      @id @default(autoincrement())
  data_do_pagamento  DateTime @db.Date
  valor_do_pagamento Decimal  @db.Decimal(12, 2)
  codigo_imovel      Int
  imovel             imovel   @relation(fields: [codigo_imovel], references: [codigo], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagamento_imovel")
}

model tipo_imovel {
  id        Int      @id @default(autoincrement())
  descricao String   @db.VarChar(100)
  imovel    imovel[]
}